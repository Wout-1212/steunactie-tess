{
  "name": "steunactie-tess",
  "private": true,
  "scripts": {
    "dev": "concurrently --names css,js --prefix-colors magenta,cyan \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/site.css --watch",
    "dev:js": "esbuild src/js/main.js --bundle --format=iife --target=chrome111,edge111,firefox128,safari16.4 --outfile=assets/js/site.js --watch=forever",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/site.css --minify",
    "build:js": "esbuild src/js/main.js --bundle --format=iife --target=chrome111,edge111,firefox128,safari16.4 --outfile=assets/js/site.js --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
